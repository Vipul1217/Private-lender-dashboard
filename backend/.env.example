# Copy this file to .env and fill in real values before running.

# --- Database ---
# Leave unset to use a local SQLite file (fastest way to run the demo).
# For Postgres (via docker-compose.yml), uncomment the line below:
# DATABASE_URL=postgresql://lender_admin:lender_pass@localhost:5432/lender_dashboard

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string-in-real-deployments
JWT_EXPIRE_MINUTES=480

# --- OTP ---
# DEV MODE: when true, /auth/send-otp returns the OTP in the API response
# and prints it to the backend console instead of sending a real SMS/email.
# Set to false and wire up a real SMS/email provider before any real
# deployment.
OTP_DEV_MODE=true
OTP_EXPIRE_SECONDS=300

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Score feedback rule (documented in app/services/score_service.py) ---
SCORE_IMPACT_ON_TIME=5
SCORE_IMPACT_LATE=-2
SCORE_IMPACT_MISSED=-5
